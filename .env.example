# WordPress (MCP server → plugin)
# Single site (legacy):
WORDPRESS_URL=http://wordpress
WORDPRESS_CONNECTION_TOKEN=dev-wp-token-local-only
# WORDPRESS_SITE_ID=default
# WORDPRESS_SITE_NAME=Local WordPress

# Multi-site (replaces WORDPRESS_URL + WORDPRESS_CONNECTION_TOKEN):
# WORDPRESS_SITES=[{"id":"abc","name":"ABC Blog","url":"https://abc.com","token":"REPLACE"},{"id":"xyz","name":"XYZ Shop","url":"https://xyz.com","token":"REPLACE"}]

# ChatGPT → MCP (local dev uses static bearer auth)
MCP_AUTH_MODE=static
MCP_AUTH_SECRET=dev-mcp-secret-local-only
MCP_PUBLIC_URL=http://localhost:3000

# MCP server
MCP_PORT=3000
MCP_HOST=0.0.0.0

# Per-tool policy (v1.2.0+)
# MCP_DISABLED_TOOLS=wordpress_delete_content,wordpress_upload_media   # disable tools by name
# MCP_ENABLED_TOOLS=wordpress_search_content,wordpress_get_content     # allowlist: only these tools run
# MCP_PROTOCOL_VERSION_POLICY=fallback                                 # fallback (default) | reject
# MCP_OBSERVABILITY_ENABLED=1                                          # structured JSON events (default on)
# MCP_MAX_SESSIONS=100                                                 # concurrent MCP session cap
# MCP_SESSION_IDLE_MS=1800000                                          # idle session eviction (default 30 min)
# MCP_JSON_BODY_LIMIT=100mb                                            # request body backstop; WordPress's own PHP limits are the real ceiling

# WordPress Docker
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_NAME=wordpress

# Dev connection scopes (comma-separated, used by seed script)
DEV_CONNECTION_SCOPES=site.read,posts.read,posts.create,posts.update,posts.publish,posts.delete,pages.read,pages.create,pages.update,pages.publish,pages.delete,comments.read,comments.moderate,terms.read,media.read,media.upload
