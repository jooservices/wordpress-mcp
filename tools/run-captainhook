#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if command -v php >/dev/null 2>&1 && [ -x packages/wordpress-plugin/vendor/bin/captainhook ]; then
  exec packages/wordpress-plugin/vendor/bin/captainhook \
    --configuration=captainhook.json \
    --bootstrap=packages/wordpress-plugin/vendor/autoload.php \
    "$@"
fi

exec docker compose run --rm --no-deps -w /app php \
  packages/wordpress-plugin/vendor/bin/captainhook \
  --configuration=/app/captainhook.json \
  --bootstrap=packages/wordpress-plugin/vendor/autoload.php \
  "$@"
