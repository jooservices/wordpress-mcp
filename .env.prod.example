# Production — copy to .env.prod and run:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# WordPress sites (plugin installed + connection created in wp-admin on each site)
#
# Option A — single site (legacy):
WORDPRESS_URL=https://blog.example.com
WORDPRESS_CONNECTION_TOKEN=REPLACE_AFTER_WP_ADMIN_CONNECTION
# WORDPRESS_SITE_ID=default
# WORDPRESS_SITE_NAME=Blog
#
# Option B — multiple sites (replaces Option A):
# WORDPRESS_SITES=[{"id":"abc","name":"ABC Blog","url":"https://abc.com","token":"REPLACE"},{"id":"xyz","name":"XYZ Shop","url":"https://xyz.com","token":"REPLACE"}]

# Public URL ChatGPT uses (must match your HTTPS endpoint + /mcp resource)
MCP_PUBLIC_URL=https://mcp.example.com

# mixed (recommended) | oauth | static | none
MCP_AUTH_MODE=mixed

# Optional — only for MCP_AUTH_MODE=static
MCP_AUTH_SECRET=

# Dev/testing only — ChatGPT "No Auth" connector
MCP_AUTH_DISABLED=false

# OAuth issuer (defaults to MCP_PUBLIC_URL origin when empty)
OAUTH_ISSUER_URL=
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_SECONDS=7776000
# Persisted OAuth clients/tokens (Docker volume mounted at this path in prod)
OAUTH_DATA_DIR=/app/data/oauth

MCP_PORT=3000
MCP_HOST=0.0.0.0

# Per-tool policy (v1.2.0+)
# MCP_DISABLED_TOOLS=wordpress_delete_content   # comma-separated tools to disable
# MCP_ENABLED_TOOLS=wordpress_search_content    # allowlist: only these tools run (when set)
# MCP_PROTOCOL_VERSION_POLICY=fallback          # fallback (default) | reject (client must use a supported version)
# MCP_OBSERVABILITY_ENABLED=1                   # structured JSON events per tool call (default on)
# MCP_MAX_SESSIONS=100                          # concurrent MCP session cap (DoS protection)
# MCP_SESSION_IDLE_MS=1800000                   # idle session eviction, default 30 min
# MCP_JSON_BODY_LIMIT=100mb                     # request body backstop; WordPress's own PHP limits are the real ceiling

# OAuth rate limiting (v1.2.1+) — disable or tune when behind Cloudflare/HAProxy
# MCP_OAUTH_RATE_LIMIT_ENABLED=1
# MCP_OAUTH_REGISTER_MAX=20
# MCP_OAUTH_REGISTER_WINDOW_MS=3600000
# MCP_OAUTH_TOKEN_MAX=50
# MCP_OAUTH_TOKEN_WINDOW_MS=900000
# MCP_OAUTH_AUTHORIZE_MAX=100
# MCP_OAUTH_AUTHORIZE_WINDOW_MS=900000
# MCP_OAUTH_REVOKE_MAX=50
# MCP_OAUTH_REVOKE_WINDOW_MS=900000
# MCP_TRUST_PROXY=1                             # trust X-Forwarded-For (default on; required for per-client OAuth limits)

# Host publish: 127.0.0.1:3000:3000 (default) or 0.0.0.0:3000:3000
MCP_PUBLISH=127.0.0.1:3000:3000

# ---------------------------------------------------------------------------
# Optional — only when using `make prod-https` (Caddy + Let's Encrypt)
# Not required for `make prod-up` if you terminate HTTPS elsewhere (nginx, cloud LB, etc.)
# ---------------------------------------------------------------------------
# Public hostname that points to this server (must match MCP_PUBLIC_URL host).
# Example: MCP_PUBLIC_URL=https://mcp.example.com → MCP_DOMAIN=mcp.example.com
# MCP_DOMAIN=mcp.example.com
# Email for Let's Encrypt certificate expiry notices (can be a team alias).
# ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Optional — only when using `make prod-tunnel` (ngrok, dev/testing)
# Not required for `make prod-up` or `make prod-https`
# ---------------------------------------------------------------------------
# NGROK_AUTHTOKEN=
