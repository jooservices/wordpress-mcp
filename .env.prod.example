# Production — copy to .env.prod and run:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# WordPress sites (plugin installed + connection created in wp-admin on each site)
#
# Option A — single site (legacy):
WORDPRESS_URL=https://blog.example.com
WORDPRESS_CONNECTION_TOKEN=REPLACE_AFTER_WP_ADMIN_CONNECTION
# WORDPRESS_SITE_ID=default
# WORDPRESS_SITE_NAME=Blog
#
# Option B — multiple sites (replaces Option A):
# WORDPRESS_SITES=[{"id":"abc","name":"ABC Blog","url":"https://abc.com","token":"REPLACE"},{"id":"xyz","name":"XYZ Shop","url":"https://xyz.com","token":"REPLACE"}]

# Public URL ChatGPT uses (must match your HTTPS endpoint + /mcp resource)
MCP_PUBLIC_URL=https://mcp.example.com

# mixed (recommended) | oauth | static | none
MCP_AUTH_MODE=mixed

# Optional — only for MCP_AUTH_MODE=static
MCP_AUTH_SECRET=

# Dev/testing only — ChatGPT "No Auth" connector
MCP_AUTH_DISABLED=false

# OAuth issuer (defaults to MCP_PUBLIC_URL origin when empty)
OAUTH_ISSUER_URL=
OAUTH_TOKEN_TTL_SECONDS=3600

MCP_PORT=3000
MCP_HOST=0.0.0.0

# Host publish: 127.0.0.1:3000:3000 (default) or 0.0.0.0:3000:3000
MCP_PUBLISH=127.0.0.1:3000:3000

# HTTPS profile (docker compose --profile https)
MCP_DOMAIN=mcp.example.com
ACME_EMAIL=you@example.com

# Tunnel profile (docker compose --profile tunnel)
NGROK_AUTHTOKEN=
